# Copy this file to .env and fill in OAuth client IDs.
# NOTE: These values are bundled with the plugin at build time.

# Google OAuth — Desktop client in GCP project obsidiansyncer-dev (consent name: Syncer Dev).
# UWP is no longer offered; new clients are Desktop (installed-app secret + PKCE). Shipped
# builds still use the old UWP client until #146 (auth) and #184+ (client cutover).
# See docs/kb/gotchas.md for canonical project IDs.

# Google OAuth (localhost redirect; shipped src/auth/google.ts has no PKCE yet — #146)
# Development builds use GOOGLE_CLIENT_ID_DEV
GOOGLE_CLIENT_ID_DEV=

# Microsoft OAuth (Auth Code + PKCE)
# Development builds use MICROSOFT_CLIENT_ID_DEV (optional; Outlook Connect disabled if omitted)
MICROSOFT_CLIENT_ID_DEV=

# Todoist OAuth (Auth Code + PKCE, public client)
# Development builds use TODOIST_CLIENT_ID_DEV (optional; Todoist Connect disabled if omitted)
# Register via POST https://api.todoist.com/oauth/register with token_endpoint_auth_method: none
# (the App Management Console only creates confidential clients). Include
# logo_uri https://obsidiansyncer.com/logo.png. Redirect URIs:
# http://localhost:27855/, http://localhost:27856/, http://localhost:27857/
TODOIST_CLIENT_ID_DEV=
