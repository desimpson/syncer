# Copy this file to .env and fill in OAuth client IDs.
# NOTE: These values are bundled with the plugin at build time.

# The Google OAuth client needs to be created as a UWP (Universal Windows Platform) app
# to avoid having to provide a client secret. See
# https://stackoverflow.com/a/78414957.

# Google OAuth (localhost redirect; no PKCE in src/auth/google.ts)
# Development builds use GOOGLE_TASKS_CLIENT_ID_DEV
GOOGLE_TASKS_CLIENT_ID_DEV=

# Microsoft OAuth (Auth Code + PKCE)
# Development builds use OUTLOOK_CLIENT_ID_DEV (optional; Outlook Connect disabled if omitted)
OUTLOOK_CLIENT_ID_DEV=
