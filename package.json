{
  "name": "syncer",
  "version": "0.1.0",
  "description": "Sync external sources like Google Tasks to your vault. More integrations to come.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:dev",
    "build:dev": "npm run typecheck && node esbuild.config.mjs --mode dev",
    "build:prod": "npm run typecheck && node esbuild.config.mjs --mode prod",
    "build:watch": "npm run typecheck && node esbuild.config.mjs --mode watch",
    "dev": "npm run build:watch",
    "format": "npm run format:check",
    "format:check": "prettier --check \"src/**/*\" \"tests/**/*\" \"*.mjs\"",
    "format:fix": "prettier --write \"src/**/*\" \"tests/**/*\" \"*.mjs\"",
    "sync": "node scripts/sync.mjs",
    "lint": "npm run lint:check",
    "lint:check": "eslint src tests scripts *.mjs --ext .ts,.mjs",
    "lint:fix": "eslint src tests scripts *.mjs --ext .ts,.mjs --fix",
    "prepare": "husky",
    "test": "vitest run --silent",
    "test:unit": "vitest run --config vitest.unit.config.ts --silent",
    "test:integration": "vitest run --config vitest.integration.config.ts --silent",
    "test:coverage": "vitest run --coverage --reporter=html",
    "test:watch": "vitest --watch",
    "test:unit:watch": "vitest --config vitest.unit.config.ts --watch",
    "test:integration:watch": "vitest --config vitest.integration.config.ts --watch",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "release:check": "node scripts/release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "google-tasks",
    "gtd",
    "productivity"
  ],
  "author": "Daniel Simpson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "editorconfig": "^3.0.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^61.0.2",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.1.6",
    "obsidian": "^1.8.7",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "**/*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "zod": "4.1.8"
  },
  "overrides": {
    "vite": "7.3.6",
    "rollup": "4.59.0",
    "postcss": "8.5.26",
    "ws": "8.21.3",
    "glob": "10.5.0",
    "flatted": "3.4.4",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "yaml": "2.8.3",
    "diff": "4.0.4",
    "fast-uri": "3.1.5",
    "ajv@6": "6.14.0",
    "minimatch@3": "3.1.5",
    "minimatch@9": "9.0.9",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5"
  },
  "engines": {
    "obsidian": ">=1.8.0",
    "node": ">=22.15"
  }
}
